---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Registry - Capsule">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold mb-4">Registry</h1>
    <p class="text-muted-foreground mb-8 max-w-2xl">
      Browse and search packages published to the Capsule Registry. Install any package with a single command.
    </p>

    <!-- Search bar -->
    <div class="mb-8">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 size-5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input
          type="text"
          id="registry-search"
          placeholder="Search packages..."
          class="w-full h-12 pl-12 pr-4 rounded-lg border border-input bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
        />
      </div>
    </div>

    <!-- Results -->
    <div id="registry-results">
      <div class="text-center py-12 text-muted-foreground">
        <svg class="size-12 mx-auto mb-4 text-muted-foreground/30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <p>Type a search term to find packages in the Capsule Registry</p>
      </div>
    </div>

    <!-- Install instructions -->
    <div class="mt-12 rounded-lg border border-border bg-card p-6">
      <h3 class="font-semibold mb-2">Publishing your own package?</h3>
      <p class="text-sm text-muted-foreground mb-4">
        Build and publish your Capsule app to the registry:
      </p>
      <code class="block px-4 py-3 rounded-md bg-black/50 text-sm text-green-400 font-mono">
        capsule build && capsule registry publish dist/myapp.capsule.app
      </code>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById("registry-search");
    const resultsDiv = document.getElementById("registry-results");
    let debounceTimer;

    async function performSearch(query) {
      if (!query.trim()) {
        resultsDiv.innerHTML = `<div class="text-center py-12 text-muted-foreground">
          <svg class="size-12 mx-auto mb-4 text-muted-foreground/30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <p>Type a search term to find packages in the Capsule Registry</p>
        </div>`;
        return;
      }

      resultsDiv.innerHTML = `<div class="text-center py-12 text-muted-foreground"><div class="animate-pulse">Searching...</div></div>`;

      try {
        const res = await fetch(`https://registry.usecapsule.net/apps/search?q=${encodeURIComponent(query.trim())}`, {
          headers: { "Accept": "application/json" },
        });

        if (!res.ok) throw new Error("Search failed");

        const data = await res.json();
        const results = Array.isArray(data) ? data : data.results ?? [];

        if (results.length === 0) {
          resultsDiv.innerHTML = `<div class="text-center py-12 text-muted-foreground">
            <svg class="size-12 mx-auto mb-4 text-muted-foreground/50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            <h3 class="text-lg font-medium mb-2">No packages found</h3>
            <p class="text-sm">Try a different search term</p>
          </div>`;
          return;
        }

        resultsDiv.innerHTML = `<div class="grid gap-4">${results.map((pkg) => `
          <div class="rounded-lg border border-border bg-card text-card-foreground shadow-sm p-6 hover:border-primary/30 transition-colors">
            <div class="flex items-start justify-between mb-3">
              <div>
                <h3 class="text-lg font-semibold"><code>${pkg.name}</code></h3>
                <p class="text-sm text-muted-foreground">${pkg.description ?? `${pkg.name}@${pkg.version}`}</p>
              </div>
              <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-secondary text-secondary-foreground shrink-0">v${pkg.version}</span>
            </div>
            <div class="flex items-center justify-between flex-wrap gap-4">
              <div class="flex items-center gap-4 text-sm text-muted-foreground">
                ${pkg.author ? `<span class="flex items-center gap-1">
                  <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  ${pkg.author}
                </span>` : ""}
                ${pkg.signed ? `<span class="flex items-center gap-1 text-green-500">
                  <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  Signed
                </span>` : ""}
              </div>
              <code class="px-3 py-1.5 rounded-md bg-muted text-xs text-muted-foreground">capsule registry install ${pkg.name}</code>
            </div>
          </div>
        `).join("")}</div>`;
      } catch {
        resultsDiv.innerHTML = `<div class="text-center py-12 text-muted-foreground">
          <p class="text-yellow-500">Could not connect to the registry. Please try again later.</p>
        </div>`;
      }
    }

    searchInput?.addEventListener("input", (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(e.target.value), 300);
    });
  </script>
</BaseLayout>
