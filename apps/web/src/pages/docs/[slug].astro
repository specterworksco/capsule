---
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  // @ts-ignore - Astro glob
  const docs = Object.entries(import.meta.glob("../../content/docs/*.md", { eager: true }));
  
  return docs.map(([path, module]) => {
    const slug = path.split("/").pop()?.replace(/\.md$/, "") ?? "";
    return {
      params: { slug },
      props: { Content: (module as { Content?: unknown }).Content ?? null, slug },
    };
  });
}

const { Content, slug } = Astro.props;
const title = (slug ?? "").replace(/-/g, " ");
---

<BaseLayout title={`${title} - Capsule Documentation`}>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <a href="/docs" class="text-sm text-muted-foreground hover:text-foreground mb-8 inline-block">
      ← Back to documentation
    </a>
    {Content ? (
      <article class="prose prose-invert prose-headings:text-foreground prose-a:text-primary prose-code:text-primary prose-pre:bg-black/50 prose-pre:border prose-pre:border-border max-w-none">
        <Content />
      </article>
    ) : (
      <div class="text-center py-12 text-muted-foreground">
        <p>Documentation not found.</p>
      </div>
    )}
  </div>
</BaseLayout>
