---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/docs", label: "Docs" },
  { href: "/registry", label: "Registry" },
];
---

<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="max-w-6xl mx-auto flex h-16 items-center justify-between px-6">
    <a href="/" class="flex items-center gap-3 font-bold text-lg">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="28" height="28" rx="6" fill="hsl(187, 100%, 42%)" />
        <path d="M7 9h14v2H7zM7 13h10v2H7zM7 17h12v2H7z" fill="hsl(0, 0%, 4%)" />
      </svg>
      Capsule
    </a>
    <nav class="flex items-center gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
