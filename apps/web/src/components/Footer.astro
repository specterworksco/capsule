---
const year = new Date().getFullYear();
---

<footer class="border-t border-border/40 mt-24">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <svg width="18" height="18" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="28" height="28" rx="6" fill="hsl(187, 100%, 42%)" />
          <path d="M7 9h14v2H7zM7 13h10v2H7zM7 17h12v2H7z" fill="hsl(0, 0%, 4%)" />
        </svg>
        <span>Capsule {year}</span>
      </div>
      <div class="flex items-center gap-6 text-sm text-muted-foreground">
        <a href="/docs" class="hover:text-foreground transition-colors">Documentation</a>
        <a href="/registry" class="hover:text-foreground transition-colors">Registry</a>
        <a href="https://github.com/specterworksco/capsule" class="hover:text-foreground transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </div>
</footer>
